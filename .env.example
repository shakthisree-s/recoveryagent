# Backend runtime configuration (all optional - sane defaults are used).
# Copy to ".env" for local overrides. NEVER commit real secrets.

# Razorpay stays in TEST MODE only.
RAZORPAY_MODE=TEST_MODE

# Path overrides (defaults resolve relative to the project root via pathlib).
# REVENUE_MODEL_PATH=./revenue_risk_model.joblib
# REVENUE_MODEL_METADATA_PATH=./model_metadata.json
# REVENUE_DB_PATH=./revenue_recovery.db
# REVENUE_AUDIT_LOG_PATH=./audit_log.json

# If you wire real Razorpay test keys for the simulation layer, put them here
# (this file is git-ignored). They are never exposed to the frontend.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
